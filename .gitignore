# ===== 通用忽略规则 =====
# 系统文件
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE 配置
.vscode/*
!.vscode/extensions.json
.idea

# ===== Python 后端 (server/) =====
# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
ENV/
.venv/
server/venv/
server/env/
server/.venv/

# Python 包管理
*.egg-info/
dist/
build/
.eggs/

# Python 测试
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Python IDE
.mypy_cache/
.dmypy.json
dmypy.json

# Python 日志
*.log
*.log.*
*.pid

# ===== Node.js 前端 (web-vue/) =====
# 环境变量
web-vue/.env
"web-vue/.claude/"

# ===== 其他 =====
# 临时文件
*.tmp
*.temp
tmp/
temp/

# 备份文件
*.bak
*.backup

# 压缩文件
*.zip
*.tar.gz
*.rar

# 环境与配置
server/.env
server/conf/*
# 模型注册表按供应商分文件、不含密钥，作为模板入库；切换供应商改 .env-{env} 里的指针
!server/conf/models*.json

# 测试产物
server/apps/chat_data_app/tests/reports/*
server/apps/chat_data_app/tests/logs/*
server/coverage.xml

# 运行日志
logs/*
server/logs/

# 工作区与数据
/.workbuddy/
/chat_data/
/server/.pytest-tmp/

# mcp_servers 本地配置
mcp_servers/.env
