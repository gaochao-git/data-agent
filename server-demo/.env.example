# 全局数据根目录（必填）
# DATA_ROOT=/absolute/path/to/data_root


#CHAT_CONTEXT_MODE，1、2、3
CHAT_CONTEXT_MODE=3
COMPLAINT_THOUGHT_LLM_MODEL="deepseek-r1-distill-qwen-32b"
COMPLAINT_RESPONSE_LLM_MODEL="Qwen3-30B-A3B-Instruct-2507"

COMPLAINT_EXTRACT_ITEMS_MODEL="Qwen3-30B-A3B-Instruct-2507"
COMPLAINT_MATCH_EXPERIENCE_MODEL="deepseek-r1-distill-qwen-32b"
COMPLAINT_LAW_ANALYSIS_MODEL="deepseek-r1-distill-qwen-32b"
COMPLAINT_FINAL_CONCLUSION_MODEL="deepseek-r1-distill-qwen-32b"
# 辅助文书撰写模型（未配置时回退 COMPLAINT_FINAL_CONCLUSION_MODEL）
# COMPLAINT_REPLY_DRAFT_MODEL="deepseek-r1-distill-qwen-32b"
COMPLAINT_FC_MODEL="Qwen3-30B-A3B-Instruct-2507"
# 举报事项经验匹配阶段是否开启思考（GLM-4.7-W8A8 可通过该开关显式下发 enable_thinking）
COMPLAINT_MATCH_EXPERIENCE_THINKING=true
# 举报事项经验匹配策略默认值：two_stage（默认）或 legacy
COMPLAINT_MATCH_STRATEGY_DEFAULT=two_stage
# 综合结论阶段是否开启思考（GLM-4.7-W8A8 可通过该开关显式下发 enable_thinking）
COMPLAINT_FINAL_CONCLUSION_THINKING=true
LLM_MESSAGES_LOG=logs/complaints_llm_messages.log
TIKTOKEN_CACHE_DIR=
# 本地开发模式（本机百炼等）：true 时仅加载 models_info.json 中 is_local=true 的模型，且不请求 LLM_MODELS_INFO_URL
IS_LOCAL=false
# 模型信息缓存秒数（默认10分钟）
MODEL_INFO_CACHE_TTL_SECONDS=600
# 可选：模型列表接口（不配置则读取本地 models_info.json）
# LLM_MODELS_INFO_URL=https://ai-llm.example.com/models

# 通用配置
DIFY_BASE_URL=http://localhost/v1
# opencode_runtime 规划器配置
# OPENCODE_MAX_PARALLEL_TASKS=3
# shell 工具同轮并发上限（用于 tool_calls 数组并行执行）
OPENCODE_MAX_PARALLEL_TOOLS=5
# OPENCODE_PLANNER_MODEL=deepseek-r1-distill-qwen-32b
# OPENCODE_RUNTIME_TRACE=false
# OPENCODE_COMPACTION_THRESHOLD=0.92
# OPENCODE_COMPACTION_TARGET_RATIO=0.75
# OPENCODE_MCP_ENABLED=false
# 多 MCP 服务配置（JSON 数组）；多服务时建议显式设置每个服务的 prefix 避免工具名冲突
# OPENCODE_MCP_SERVERS=[{"id":"pbc_regulations","url":"http://127.0.0.1:8000/mcp/sse","enabled":true,"prefix":"pbc","priority":100,"timeout_seconds":8,"cache_ttl_seconds":300,"expose_unprefixed":false}]

# 单个文件上传大小限制（MB，可选，默认50）
# MAX_UPLOAD_SIZE_MB=50

# OCR识别并发数（可选，默认10）
# OCR_MAX_CONCURRENCY=10

# =============== 制度目录主数据配置 ===============
# 制度目录主数据 merged_outline.json 路径；未配置时可回退到仓库内 mock 示例
# ZHIDU_MERGED_OUTLINE_JSON=/absolute/path/to/merged_outline.json

# 任务三详细分析并发数（可选，默认3）
# TASK3_MAX_CONCURRENCY=3

# 文本长度触发工作流阈值（可选，默认4096）
# WORKFLOW_TEXT_LENGTH_THRESHOLD=4096

# JWT 登录配置
# JWT_SECRET_KEY=replace-this-in-production
# JWT_EXPIRATION_MINUTES=43200
# JWT_COOKIE_NAME=inner_token
# JWT_COOKIE_SECURE=false
# JWT_COOKIE_SAMESITE=Lax
# SERVICE_AUTH_TOKEN=replace-this-in-production
# tkn_8f7cQZ1n4pL9xW2y_V0mB3aH6kT5uR-7eJ9dN2sC4vX1
# tkn_kR3pN8zV1qS7mY4x_A6bF9wL2tG5hJ-0uC8dE3iP1oZ6
# tkn_5aT9yK2nW7xR4vQ1_J8mZ6uB3sH0gL-9pD2cF7eN1iX4

# OpenAI 模型配置
# 用于法律案例分析流式输出
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANALYSIS_MODEL="deepseek-r1-distill-qwen-32b"
OPENAI_SUGGEST_MODEL="deepseek-r1-distill-qwen-32b"
OPENAI_MINDMAP_MODEL="deepseek-r1-distill-qwen-32b"

#举报件长度切割条件
WORKFLOW_TEXT_LENGTH_THRESHOLD=10000000
#执法检查chat app
DIFY_INSPECTION_CHAT_API_KEY=app-cPqphLRSIQkpXIzZFFEUcOTp

# =============== 操作手册问答机器人 ===============
DIFY_CHAT_ASSIST_API_KEY=app-your-operation-manual-chat-key   
# =============== 操作手册问答机器人 END ===============

#举报件处理时pdf的中间位置
URL_PATH_PREFIX="/"
DIFY_INFER_API_URL=
# COMPLAINT_UPLOAD_ROOT= #自定义上传目录
# file_id 下载配置（complaint/word_fit 复用）
# FILE_DOWNLOAD_API_URL=http://localhost:8000/download
# FILE_DOWNLOAD_USER=user
# FILE_DOWNLOAD_TOKEN=123456
# FILE_DOWNLOAD_CLUSTER=12
# WORDFIT_DOWNLOAD_DIR=/absolute/path/to/wordfit/downloads
# WORDFIT_OCR_MAX_WAIT_SECONDS=10
# 开发模式可选：若配置本地 PDF，则 complaint 的 file_id 模式优先使用该文件，不走远程下载
# COMPLAINT_API_DEBUG_PDF_PATH=/absolute/path/to/mock.pdf

# 法规检索服务配置（regulationassistant）
# POLICY_SERVICE_PROVIDER=legacy  # legacy 或 alt/new（A2A）
POLICY_SERVICE_BASE_URL=http://localhost:8000
# POLICY_SERVICE_A2A_BASE_URL=http://localhost:8000/a2a
# 如果上游政策服务使用自签名证书，开发环境可临时关闭 TLS 校验
# POLICY_SERVICE_VERIFY_TLS=false

# 举报件处理中是否将url中的http替换为https，默认true，生产环境开启，开发环境关闭
REPLACE_HTTP_WITH_HTTPS=true
# 举报件专家经验
# COMPLAINT_UPLOAD_ROOT=/data/aigc/expert_complaint/

# =============== 日志配置 ===============
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL，生产环境建议使用 INFO，开发调试使用 DEBUG
LOG_LEVEL=INFO
# 日志文件目录（相对或绝对路径）
LOG_DIR=logs
# 日志文件名（所有模块共享同一个日志文件）
LOG_FILE=fxcjg_app.log
# 是否输出到控制台：true/false（DEBUG模式自动开启）
LOG_CONSOLE=false
# 说明：日志每天凌晨自动切割，切割后文件名如 fxcjg_app.log.2025-11-12，默认保留最近30天

# =============== AI Trace 配置 ===============
# 是否启用专家系统 trace：true/false
AI_TRACE=false
# trace 落盘目录（默认：DATA_ROOT/case_library/trace）
# AI_TRACE_DIR=${DATA_ROOT}/case_library/trace

# 是否开启调试接口（如 trace 读取），生产环境建议关闭
DEBUG=false

PAYMENT_SPECIALIST_AGENT_IMPL=payment_specialist_workflow


UVICORN_ACCESS_LOG=true
UVICORN_LOG_LEVEL=info
UVICORN_ACCESS_FORMAT="%(asctime)s %(levelname)s %(client_addr)s \"%(request_line)s\" %(status_code)s"
UVICORN_ACCESS_DATEFMT="%Y-%m-%d %H:%M:%S"

# =============== SM4 加密配置 ===============
# 用于加密敏感信息（如数据库密码）
# 进入目录: cd server
# 生成密钥: python -c "import os; print(os.urandom(16).hex())"
# 加密密码: ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto encrypt "{password}"
# 解密密码: ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto decrypt "{ciphertext}"
ENCRYPT_KEY={生成的密钥}

# =============== 智能体历史对话保存数据库配置 ===============
## langchain检查点类型：sqlite/mysql
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_HOST={mysql_ip}
CHECKPOINTER_PORT={mysql_port}
CHECKPOINTER_DB=langchian_checkpoint
CHECKPOINTER_USER=fxcjg_rw
CHECKPOINTER_PASSWORD=加密后的密码
# =============== 业务数据库配置 ===============
# 业务表库使用 FXCJG_DB_*，存在该组配置时默认按 mysql 处理
FXCJG_DB_HOST={mysql_ip}
FXCJG_DB_PORT={mysql_port}
FXCJG_DB=fxcjg_ai
FXCJG_DB_USER=fxcjg_rw
FXCJG_DB_PASSWORD=加密后的密码
# =============== ChatData SQL 执行配置 ===============
# 智能问数模型配置
CHAT_DATA_API_KEY=your-chat-data-api-key
CHAT_DATA_BASE_URL=https://api.openai.com/v1
CHAT_DATA_MODEL="gpt-4o-mini"
# SQL 安全限制（可配置，多个用逗号分隔）
CHATDATA_ALLOWED_SQL=SELECT,SHOW,EXPLAIN,DESCRIBE
# 查询结果行数限制（默认100）
CHATDATA_ROW_LIMIT=100
# MySQL 查询默认超时时间（秒）
CHAT_DATA_MYSQL_QUERY_TIMEOUT_SECONDS=60
# Hive 查询默认超时时间（秒）
CHAT_DATA_HIVE_QUERY_TIMEOUT_SECONDS=600
# 数据库连接超时（秒）
CHAT_DATA_DB_CONNECT_TIMEOUT_SECONDS=3
# Hive socket 读写超时（秒）
CHAT_DATA_HIVE_SOCKET_TIMEOUT_SECONDS=10
# 数据源同步任务总超时（秒）
CHAT_DATA_DATASOURCE_SYNC_TIMEOUT_SECONDS=30
# Hive 同步表结构最大并发
CHAT_DATA_HIVE_SCHEMA_MAX_WORKERS=10
# 看板面板批量执行最大并发数（默认 8）
CHAT_DATA_DASHBOARD_PANEL_MAX_CONCURRENCY=8
# HTTP 查询任务轮询间隔（毫秒）
CHAT_DATA_HTTP_POLL_INTERVAL_MS=1500
# HTTP 查询提交接口
CHAT_DATA_HTTP_SUBMIT_URL=
# HTTP 查询状态接口，支持 {task_id} 占位
CHAT_DATA_HTTP_STATUS_URL=
# HTTP 查询鉴权 Token（可选）
CHAT_DATA_HTTP_AUTH_TOKEN=
# HTTP 查询是否校验证书：true/false，默认 false
CHAT_DATA_HTTP_VERIFY_TLS=false
# 表结构获取方式：cache（从缓存读取，默认）或 live（实时从数据库获取）
CHAT_DATA_SCHEMA_SOURCE=cache
# ChatData MySQL 表结构同步和 SQL 查询账号配置
CHAT_DATA_MYSQL_USER=
CHAT_DATA_MYSQL_PASSWORD=加密后的密码
# ChatData Hive 表结构同步和 SQL 查询账号配置
CHAT_DATA_HIVE_USER=
CHAT_DATA_HIVE_PASSWORD=
