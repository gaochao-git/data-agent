flowchart TB
    subgraph LOCAL[本地开发环境]
        LFE[psoss-fe\nnpm run dev]
        LPY[fxcjg/server\n本地启动验证]
    end

    subgraph UAT[UAT环境]
        subgraph UDMZ[DMZ区]
            UDN[nginx]
            UWEB[Java Web]
            UFE[psoss-fe]
        end
        subgraph UAPP[App区]
            UNG[nginx]
            UPY1[Python主]
            UPY2[Python备1]
            UPY3[Python备2]
            UJS[Java Service]
            UDB[(DB)]
        end
    end

    subgraph PROD[生产环境]
        subgraph PDMZ[DMZ区]
            PDN[nginx]
            PWEB[Java Web]
            PFE[psoss-fe]
        end
        subgraph PAPP[App区]
            PNG[nginx]
            PPY1[Python主]
            PPY2[Python备1]
            PPY3[Python备2]
            PJS[Java Service]
            PDB[(DB)]
        end
    end

