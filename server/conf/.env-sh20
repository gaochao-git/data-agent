# 工会百炼
CHAT_DATA_API_KEY=2uomrHFAVp0HhH8ZjFafZg==:92BNyXfCuWCrTRdYs0XDR+8q/1B0meiyz6Q+Ar7tMGqbPBtxpXXFtG8yiWZifpRS
CHAT_DATA_BASE_URL=http://0yc4r0gn901.copilot.rds.aliyuncs.com/compatible-mode/v1
CHAT_DATA_MODEL="kimi-k2.5"
# 智能问数和智能分析主链路模型温度
CHAT_DATA_TEMPERATURE=0.2
CHAT_DATA_ENABLE_THINKING=false
CHAT_DATA_ANALYZE_ENABLED=true
# SQL 安全限制（可配置，多个用逗号分隔,SHOW,EXPLAIN,DESCRIBE这三个SQL语法sqlglot解析不出来，先不支持了，后续需要单独做接口）
CHATDATA_ALLOWED_SQL=SELECT
# 查询结果行数限制（默认100）
CHATDATA_ROW_LIMIT=10000
# 工具结果超过该字符数时写入 artifact，避免大结果进入大模型上下文（默认150000）
CHATDATA_TOOL_RESULT_OFFLOAD_SIZE=150000
# 智能问数 SQL 执行是否使用异步查询任务和 LangGraph 恢复机制
CHAT_DATA_AGENT_SQL_ASYNC_ENABLED=false
# MySQL 查询默认超时时间（秒）
CHAT_DATA_MYSQL_QUERY_TIMEOUT_SECONDS=60
# Hive 查询默认超时时间（秒）
CHAT_DATA_HIVE_QUERY_TIMEOUT_SECONDS=600
# 数据库连接超时（秒）
CHAT_DATA_DB_CONNECT_TIMEOUT_SECONDS=3
# Hive socket 读写超时（秒）
CHAT_DATA_HIVE_SOCKET_TIMEOUT_SECONDS=10
# 数据源同步任务总超时（秒）
CHAT_DATA_DATASOURCE_SYNC_TIMEOUT_SECONDS=30
# Hive 同步表结构最大并发
CHAT_DATA_HIVE_SCHEMA_MAX_WORKERS=10
# 看板面板批量执行最大并发数（默认 8）
CHAT_DATA_DASHBOARD_PANEL_MAX_CONCURRENCY=20
# 沙箱类型，目前仅支持 opensandbox
WORKSPACE_EXECUTION_BACKEND=opensandbox
# OpenSandbox 配置
OPENSANDBOX_URL=http://62.234.152.217:18080
OPENSANDBOX_API_KEY=f95bc722cfe12248c8aaeb98ee8eade109679ac20e9e15f5c0269486a1f57540
OPENSANDBOX_WORKSPACE_ROOT=/mnt
OPENSANDBOX_WORKSPACE_SYNC_MODE=remote-host-volume
OPENSANDBOX_HOST_WORKSPACE_ROOT=/data/sandbox/workspace
OPENSANDBOX_HOST_PROJECT_NAME=fxcjg
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_IMAGE=ubuntu-chatdata:22.04-amd64
OPENSANDBOX_NETWORK_DEFAULT_ACTION=deny
OPENSANDBOX_TIMEOUT_SECONDS=600
OPENSANDBOX_READY_TIMEOUT_SECONDS=60
OPENSANDBOX_PYTHON_BIN=python3
# 表结构获取方式：cache（从缓存读取，默认）或 live（实时从数据库获取）
CHAT_DATA_SCHEMA_SOURCE=cache
# MySQL 同步表结构和 SQL 查询用户
CHAT_DATA_MYSQL_USER=db_query_ro
# MySQL 同步表结构和 SQL 查询密码
CHAT_DATA_MYSQL_PASSWORD=9xoGNhhQOhCKkg30NF/dPA==:teAdsWfDfAutVqg7GTFJHw==
# Hive 同步表结构和 SQL 查询用户
CHAT_DATA_HIVE_USER=hive
# Hive 同步表结构和 SQL 查询密码（可留空）
CHAT_DATA_HIVE_PASSWORD=
# ChatData 任务提交接口
CHAT_DATA_HTTP_SUBMIT_URL=http://127.0.0.1:18081/mock-http-query/submit
# ChatData 状态查询接口，成功会返回结果
CHAT_DATA_HTTP_STATUS_URL=http://127.0.0.1:18081/mock-http-query/status/{task_id}
# ChatData 停止接口
CHAT_DATA_HTTP_STOP_URL=http://127.0.0.1:18081/mock-http-query/stop
# 元数据 HTTP 模式：获取表名列表接口
CHAT_DATA_META_TABLES_URL=http://127.0.0.1:18081/meta/tables
# 元数据 HTTP 模式：获取完整表结构接口
CHAT_DATA_META_SCHEMA_URL=http://127.0.0.1:18081/meta/schema
# 元数据 HTTP 模式：单次请求超时（秒）
CHAT_DATA_META_TIMEOUT_SECONDS=30
# ChatData 认证token
CHAT_DATA_HTTP_AUTH_TOKEN=KXZQfT8pufUtmhnZAmpQig==:RzbXLl7zKsNbi+RIl5zH0eSY3xo/IZocUKBYPz9IM4A=
# ChatData 轮询间隔（毫秒）
CHAT_DATA_HTTP_POLL_INTERVAL_MS=5000
# ChatData 是否校验证书：true/false，默认 false
CHAT_DATA_HTTP_VERIFY_TLS=false
# SQL 查询结果缓存开关：true/false（默认 false）
CHAT_DATA_QUERY_CACHE_ENABLED=false
# SQL 查询结果缓存过期时间（秒，默认 3600）
CHAT_DATA_QUERY_CACHE_TTL_SECONDS=3600
CHAT_DATA_SQL_USER_DATASOURCE_MAX_CONCURRENCY=2

# 本地开发服务转发认证令牌；需与 web-vue/.env 的 AGENT_SERVICE_TOKEN 一致
SERVICE_AUTH_TOKEN=local-dev-service-token
