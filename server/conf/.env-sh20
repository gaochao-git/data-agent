# 端口
PORT=5001
# 全局数据根目录（可选，默认 ./server/uploads）
DATA_ROOT=./uploads

# 开启热更新
FASTAPI_RELOAD=true
# =============== 日志配置 ===============
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL，生产环境建议使用 INFO，开发调试使用 DEBUG
LOG_LEVEL=DEBUG
# 日志文件目录（相对或绝对路径）
LOG_DIR=logs
# 日志文件名（所有模块共享同一个日志文件）
LOG_FILE=data_agent_app.log
# 是否输出到控制台：true/false（DEBUG模式自动开启）
LOG_CONSOLE=true
# 说明：日志每天凌晨自动切割，切割后文件名如 data_agent_app.log.2025-11-12，默认保留最近30天

# =============== 加密配置 ===============
# 进入目录: cd xxxxfxcjg/server
# 生成密钥：python -c "import os; print(os.urandom(16).hex())"
# 加密密码：ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto encrypt "{password}"
# 加密密码解密：ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto decrypt "CHECKPOINTER_PASSWORD"
ENCRYPT_KEY=c056f39d10cac8fad14c71237ace25d3

