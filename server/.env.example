# ChatData 后端环境变量模板
# 段落划分与键顺序与服务实际运行配置 conf/.env-<env>（如 conf/.env-dev）保持一致，便于逐项比对。
# 本文件只作为模板入库：所有口令、Token、API Key 一律留空，需按下方注释用 SM4 加密后填入；
# 真实值写在 server/conf/.env-<env> 或 server/.env，禁止提交到仓库。

# =============== 服务配置 ===============
# 端口
PORT=5001
# 是否开启热更新（仅 python main.py 直启生效；gunicorn 启动忽略本项）
FASTAPI_RELOAD=true
# Gunicorn worker数量，采用Gunicorn启动生效
GUNICORN_WORKERS=4
# Gunicorn worker 超时时间（秒），智能体/SQL/沙箱请求可能较长
GUNICORN_TIMEOUT=900
# Gunicorn 优雅退出等待时间（秒）
GUNICORN_GRACEFUL_TIMEOUT=30
# Gunicorn keepalive 时间（秒）
GUNICORN_KEEPALIVE=5
# 认证令牌
SERVICE_AUTH_TOKEN=
# 加密密钥
ENCRYPT_KEY=

# =============== 日志配置 ===============
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL，生产环境建议使用 INFO，开发调试使用 DEBUG
LOG_LEVEL=DEBUG
# 日志文件目录（相对或绝对路径）
LOG_DIR=logs
# 日志应用名，同时作为日志文件名前缀；默认生成 data-agent_app.log / data-agent_acc.log / data-agent_alarm.log
LOG_APP_NAME=data-agent
# 是否输出到控制台：true/false（DEBUG模式自动开启）
LOG_CONSOLE=true
# 说明：日志每天凌晨自动切割，切割后文件名如 data-agent_app.log.2025-11-12，默认保留最近30天

# =============== 数据库配置 ===============
## 智能体历史会话保存数据库配置：sqlite/mysql；开发单进程可 sqlite，生产多实例必须 mysql
CHECKPOINTER_TYPE=mysql
# 支持单节点或多节点 host:port 列表；每个节点都必须显式写端口
# 示例：CHECKPOINTER_HOST=10.0.0.1:3306,10.0.0.2:3307,10.0.0.3:3306
CHECKPOINTER_HOST=
CHECKPOINTER_DB=langchain_checkpoint
CHECKPOINTER_USER=
# SM4 加密后的密文，生成方式同 SERVICE_AUTH_TOKEN
CHECKPOINTER_PASSWORD=
## 业务数据库配置
# 支持单节点或多节点 host:port 列表；每个节点都必须显式写端口
# 示例：FXCJG_DB_HOST=10.0.0.1:3306,10.0.0.2:3307,10.0.0.3:3306
FXCJG_DB_HOST=
FXCJG_DB=fxcjg_ai
FXCJG_DB_USER=
# SM4 加密后的密文，生成方式同 SERVICE_AUTH_TOKEN
FXCJG_DB_PASSWORD=

# =============== redis配置 ===============
# Redis Streams：Run 实时事件、SSE 重连和跨进程事件分发（仅哨兵模式）
CHAT_DATA_REDIS_SENTINELS=
# 哨兵密码，SM4 加密后的密文；仅当哨兵节点单独开启认证时填写，留空则不向哨兵发送 AUTH（不继承主库密码）
CHAT_DATA_REDIS_SENTINEL_PASSWORD=
# 哨兵逻辑主名字
CHAT_DATA_REDIS_MASTER_NAME=chatdata-master
# redis主库密码，SM4 加密后的密文
CHAT_DATA_REDIS_PASSWORD=
# redis db序号（逻辑库编号，等价于旧 CHAT_DATA_REDIS_URL 的 /N 后缀），缺省 0
CHAT_DATA_REDIS_DB=0
# 过期时间，控制redis内存
CHAT_DATA_REDIS_STREAM_TTL_SECONDS=3600
# Redis 空闲连接健康检查间隔（秒），0 表示关闭
CHAT_DATA_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Redis 建立 TCP 连接超时时间（秒）
CHAT_DATA_REDIS_CONNECT_TIMEOUT_SECONDS=5
# Redis 命令连接异常重试次数，发布脚本按事件 ID 幂等
CHAT_DATA_REDIS_COMMAND_RETRIES=2
CHAT_DATA_REDIS_SOCKET_TIMEOUT_SECONDS=20

# =============== LLM配置 ===============
# 大模型清单已页面化管理：「大模型管理」面板维护（存 DB 表 chat_data_model_registry，
# 每行自带 base_url / api_key 密文，支持多家供应商并存），无需再配供应商环境变量。
# 旧变量 CHAT_DATA_API_KEY / CHAT_DATA_BASE_URL / CHAT_DATA_MODEL / CHAT_DATA_MODELS_FILE 已废弃：
# 服务端不再读取（CHAT_DATA_MODEL 残留会导致启动报错）。模型清单唯一真值是 DB 表
# chat_data_model_registry（大模型管理页维护），表为空即空清单，不再从任何文件自动导入。
#
# 模型注册表进程内缓存 TTL（秒，默认 30）：多实例部署下其它实例的管理变更至多延迟该时长生效
#CHAT_DATA_MODEL_REGISTRY_CACHE_TTL_SECONDS=30

# 模型流式分块超时（秒）：TCP 连接存活但超过该秒数无任何流式内容返回时主动中断（langchain-openai 看门狗）。
# 默认 120；设为 0 关闭该看门狗（不推荐，僵尸流会一直挂起）。模型构造时从进程环境读取，改后须重启。
LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=120

# =============== 智能体上下文管理 ===============
# 智能体超步控制：主智能体与子智能体各自一次运行的 super-step 上限，两处同源（子图整体只占主图 1 步、内部再独立计量）；代码默认 40
CHAT_DATA_AGENT_RECURSION_LIMIT=500
# 单个进程数据智能体对话并发数
CHAT_DATA_AGENT_MAX_CONCURRENCY=4
# 上下文压缩开关；仅在上下文接近阈值时压缩较早消息，不影响单轮结果卸载
CHAT_DATA_CONTEXT_COMPRESSION_ENABLED=true
# 触发压缩比例：当前输入达到或超过该比例时，每次模型调用前都会尝试压缩；默认 0.70，必须大于 0 且不超过 0.95。
# 超过 0.95、非数字或非正数会阻止服务启动；实际触发点还会受“硬输入容量的 95% 安全水位”约束并取更早者。
CHAT_DATA_CONTEXT_COMPRESSION_TRIGGER_RATIO=0.70
# 压缩摘要保留输出：上下文压缩时，摘要模型调用的最大输出 token；独立于主模型输出预留
# 未配置时按模型上下文窗口动态计算 min(窗口/20, 12000)，下限 2000；显式配置后以该值为准
#CHAT_DATA_CONTEXT_COMPRESSION_SUMMARY_OUTPUT_MAX_TOKENS=12000
# 会话记忆开关：每轮对话正常结束后由模型自动抽取「已确认口径、纠错结论、格式偏好」等写入本会话
# 记忆目录（/mnt/user-data/memory/memory.md，用户可见可编辑可删除，天然人工治理通道），并在后续
# 轮次自动注入 system prompt；仅本会话生效，不跨会话共享。抽取失败仅告警降级，不影响对话。
CHAT_DATA_SESSION_MEMORY_ENABLED=true
# 会话记忆最大条目数（正整数，默认 20）：超出时按文件内顺序保留最新条目。
CHAT_DATA_SESSION_MEMORY_MAX_ITEMS=20
# 会话记忆注入 system prompt 的字符预算（约等于 token，默认 1500）：超出时从最新条目往回保留。
CHAT_DATA_SESSION_MEMORY_INJECTION_MAX_TOKENS=1500
# 上下文预算中预留的最大输出量：单次 ChatData 主模型调用的最大输出 token；同时作为输入预算预留
# 此为全局默认值，可在模型注册表 models.json 中按模型配置 max_output_tokens 覆盖（思考型模型建议调大）
CHAT_DATA_OUTPUT_MAX_TOKENS=4096
# 工具结果超过该字符数时卸载到磁盘（写入当前会话目录，避免大结果进入大模型上下文）
CHAT_DATA_TOOL_RESULT_OFFLOAD_SIZE=20000
# file_read单次返回给模型的最大正文字符数（至少 4096）；file_read 默认 200 行、最多 500 行，单行最多 500 字符。
CHAT_DATA_FILE_READ_MAX_CHARS=25000
# 是否开启前端系统提示词查看；仅在上下文预算明细中展示 system prompt 原文，仅排查问题时开启
CHAT_DATA_CONTEXT_USAGE_SHOW_SYSTEM_PROMPT=true
# 单文件上传大小上限（MB，正整数），默认 50；流式边读边判，超限直接拒绝并清理临时文件。
# 注意：前端另有一份 50MB 的客户端预检（AnalysisConversation.vue 的 MAX_FILE_SIZE），调大本值时须同步前端，否则大文件会在前端被拦下。
CHAT_DATA_MAX_UPLOAD_SIZE_MB=50

# 上传文件应用层加密原型（AES-256-GCM）：值为 SM4 密文，和数据库密码共用 ENCRYPT_KEY。
# 生成明文密钥：python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# 加密为密文：cd server && python scripts/crypto.py encrypt "<明文密钥>"
# 留空关闭。
CHAT_DATA_UPLOAD_ENCRYPTION_KEY=
# 单张图片进入模型上下文的大小上限（MB，正整数），默认 5；同时约束 read_image 工具、视觉注入中间件与扫描版 PDF 渲染页（超限时自动降 DPI 重渲染）。
CHAT_DATA_MAX_IMAGE_SIZE_MB=5
# 扫描版 PDF 视觉转写的最大页数上限（正整数），默认 10；parse_document 检测到 PDF 无文本层时,
# 用 PyMuPDF 渲染页面 + 视觉模型转写为 Markdown,超出页数只转写前 N 页并在结果中注明。
CHAT_DATA_MAX_SCAN_PDF_PAGES=10
# 会话工作区文本文件预览源大小上限（MB，正整数），默认 5；超限拒绝预览（下载不受影响）。
# 注意：前端渲染另有 1MB 截断（AnalysisConversation.vue 的 CONSOLE_TEXT_RENDER_MAX_CHARS），超限只显示前 1MB 并提示下载。
CHAT_DATA_TEXT_PREVIEW_MAX_MB=5
# 会话工作区 Office 文件预览源大小上限（MB，正整数），默认 50；与转出 HTML 的字符上限（12MB）是两回事。
CHAT_DATA_OFFICE_PREVIEW_SOURCE_MAX_MB=50
# 会话工作区目录打包下载的压缩包大小上限（MB，正整数），默认 50；限的是 zip 产物字节而非源文件总大小，超限中止打包并报错。
CHAT_DATA_WORKSPACE_ARCHIVE_MAX_MB=50
# 大模型首个可见输出超过该秒数时写 alarm 日志
CHAT_DATA_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=60
# 合规要求：单个会话在统计窗口内的工具调用数超过阈值时写 alarm 日志（不阻断工具执行）；默认 100 次 / 60 秒
# 计数按会话在单个 worker 进程内聚合（GUNICORN_WORKERS 默认 4）：单次运行（同一长连接）精确，多进程并发同一会话时只可能低估
CHAT_DATA_TOOL_CALL_RATE_ALERT_THRESHOLD=100
CHAT_DATA_TOOL_CALL_RATE_ALERT_WINDOW_SECONDS=60

# =============== 智能体安全模式管理 ===============
# 说明（2026-10-20 起）：隔离后端属于**部署能力**，只由本文件/部署配置决定，
# 不接受前端动态传参（前端已无「权限选择/审批模式」入口，见下方审批策略）。
# 隔离模式：local 或 sandbox。职责是「标准化运行环境」（统一 Python/依赖、不污染宿主），不是安全隔离设备。
# 工具启停由 tools/registry.py 的 ToolDefinition.enabled 控制。
CHAT_DATA_DEFAULT_WORKSPACE_BACKEND=local
# 工具审批策略（B 端固定策略，2026-10-21 起无全局开关、无用户可选模式）：
# 是否需要审批由服务端按工具强制决定，用户不能选择「按需/自动」，也没有「本轮/本会话始终允许」。
# 内置强制审批工具 = 注册表 ToolDefinition 的 approval（当前 file_delete / dir_delete / file_move）；
# MCP 动态工具默认严格（mcp_ 前缀统一 ask，mcp_tool_search 只读检索除外）。
# 单工具档位在 plugin.json 的 mcp_servers[].tool_approvals 声明：allow 免审批 / 缺省 ask；
# 旧值 auto→allow、force_ask→ask；deny 仅表示「该工具不挂载」。
# 无人值守运行（定时任务/评测）不装配审批中间件，需审批工具在装配层直接剔除（fail-closed，不悬挂）。
# 原 CHAT_DATA_DEFAULT_APPROVAL_MODE 变量与对应配置项已删除，配置后不再生效。
# 子智能体：任一开关启用即注册 task 工具，允许主智能体把长任务派发给隔离上下文的子智能体，
# 仅结论回到主对话（见 agent/middleware/subagents.py）。
# explore = 只读事实收集（批量盘点/口径确认/数据核对，无写操作工具）。
CHAT_DATA_DEFAULT_EXPLORE_SUBAGENT_ENABLED=false
# plan = 统一规划（为复杂任务产出计划文件，只规划不执行，执行由主智能体完成）。
CHAT_DATA_DEFAULT_PLAN_SUBAGENT_ENABLED=false
# 子智能体预算告警线可选覆盖（上下文窗口比例，调试/压测用）：达到后每轮注入「提前收尾」提示。
# 不设置时与主图压缩触发阈值同源（窗口 × CHAT_DATA_CONTEXT_COMPRESSION_TRIGGER_RATIO）；
# 设置后仅覆盖子图告警线（换算值不超过该模型硬限）。用法：临时设 0.05 之类的小值让
# 告警线先于压缩线触发，肉眼验证「预算告警→提前收尾」链路，测完删除即恢复同源。
# 注意：纯软约束——是否收尾由模型决定，无视提示时由窗口溢出失败路径兜底；
# 摘工具强制收尾方案（硬线）已于 2026-09-21 试验后废弃，勿再引入。
# CHAT_DATA_SUBAGENT_BUDGET_ALERT_TRIGGER_RATIO=
# semantic_search 工具（LLM 打分召回）开关；关闭后 Agent 纯走预物化目录
# （dir_list/file_grep/file_read）检索语义模型；启用模型 YAML 预物化不受此开关影响。
CHAT_DATA_SEMANTIC_SEARCH_ENABLED=true
# 终端用户「语义模型」入口开关，true/false（默认 false）：
# 关闭时前台完全不显示「语义模型配置」页签（不是只藏新建按钮）——管理员仍可从「后台管理 → 模型」维护；
# 打开后恢复该页签与「+ 新建语义模型」自助建模（用于存量模型迁移、临时试用等场景）。语义模型接口不受影响。
# 这是运行期配置变量（后台「运行配置 → 功能开关」可改，≤30 秒生效，前端刷新页面后页签才出现），
# 本文件仅作部署级兜底默认值；口径为「严格 true 才开放」，未配置、未下发或配置未加载一律按关闭处理。
CHAT_DATA_USER_SEMANTIC_MODEL_ENABLED=false

# 本体目录注入开关（默认关闭）：开启后把绑定到本轮启用语义模型的 certified/experimental
# 本体对象物化为 workspace/semantic/_ontology_catalog.yaml（含全部启用模型索引），
# agent 优先读本体目录导航业务对象；关闭时回落到 _semantic_catalog.yaml。
# 本项目为实验分支验证期开关，生产默认 false。
CHAT_DATA_ONTOLOGY_INJECTION_ENABLED=false

# 混合查询模式（默认关闭）：开启后本体业务域同时物化语义模型目录并装配
# data_analyzing_tool + ontology_tool，由 data-analyzing 技能按意图路由。
# 关闭时保持指标语义层/本体层二选一。
CHAT_DATA_QUERY_MODE_HYBRID=false

# 本体对象定位开关（默认关闭）：开启后 data_analyzing_tool 的 locate_object
# action 可用——按本体对象批量返回绑定语义模型（含快照文件名）、属性→维度对照
# 与对象关系，纯导航不执行查询（可定位范围 ⊆ 本轮启用模型绑定的对象）。
# 依赖本体建模与映射数据，与 CHAT_DATA_ONTOLOGY_INJECTION_ENABLED 建议同开。
CHAT_DATA_ONTOLOGY_LOCATE_ENABLED=false

# 本体对象实例读取开关（默认关闭）：开启后 ontology_tool 的 get_object action 可用，
# 按对象类型 + 主键读取对象属性与一跳外键型 links（只读、复用当前用户数据源授权）。
# 依赖本体建模/映射；与 CHAT_DATA_ONTOLOGY_LOCATE_ENABLED 建议同开。
CHAT_DATA_ONTOLOGY_OBJECT_READ_ENABLED=false

# 本体 Action 执行开关（默认关闭）：开启后 action-types/{name}/execute 可执行
# experimental/certified Action——写入对象属性覆盖层 + 执行审计，不直接改源库；
# 对象读取会合并覆盖值。需要先执行 next_version.md 的 Action 执行表 DDL。
CHAT_DATA_ONTOLOGY_ACTION_EXECUTE_ENABLED=false
# 图查询（NebulaGraph 只读关系投影；先做 PoC，默认关闭）
# 图库只存对象身份/标题/关系边，属性与指标仍走 SQL/语义层。
CHAT_DATA_NEBULA_ENABLED=false
# 图读后端：sql（MVP，不要求图同步）或 nebula；未配置时 Nebula 开启则 nebula，否则 sql
CHAT_DATA_GRAPH_BACKEND=sql
CHAT_DATA_NEBULA_HOSTS=127.0.0.1:9669
CHAT_DATA_NEBULA_USER=root
CHAT_DATA_NEBULA_PASSWORD=nebula
CHAT_DATA_NEBULA_SPACE=chatdata_graph
CHAT_DATA_NEBULA_EDGE_TYPES=belongs_to
CHAT_DATA_NEBULA_TIMEOUT_SECONDS=10
# 可选：本地 nebula3 客户端目录（生产由 requirements.txt 安装，留空即可）
CHAT_DATA_NEBULA_DEPS=
# 图同步容量保护：单对象类型最大节点数 / 单关系最大边数，超过则拒绝同步
CHAT_DATA_NEBULA_SYNC_MAX_NODES_PER_TYPE=200000
CHAT_DATA_NEBULA_SYNC_MAX_EDGES_PER_RELATION=500000

# =============== ChatData 数据根目录（必填，应用侧唯一数据根） ===============
# CHAT_DATA_HOME 是 chat 应用唯一的数据根目录：会话/工作区、artifact、用户技能
# (skills/user) 都派生自此。必须显式指定绝对路径，禁止回退到其它变量推导；local 与 sandbox 模式都需要。
# 结构：threads/{user_id}/{创建日期YYYY-MM-DD}/{conversation_id}/user-data/{workspace,uploads,outputs}
# 及 threads/{user_id}/{创建日期YYYY-MM-DD}/{conversation_id}/runtime-skills（会话级只读技能快照，
# 按会话创建日期归档，路径统一由 utils.storage_paths.conversation_thread_dir 拼装）；
# 大工具结果位于 outputs/.tool-offload（隐藏缓存，不作为用户产物展示）。
# 系统技能位于 skills/system，用户技能位于 skills/user/{user_id}。
# 发布时将代码包的系统技能目录复制到 skills/system；运行时不写入数据库。
CHAT_DATA_HOME=

# =============== ChatData SQL 执行配置 ===============
# SQL 安全限制（可配置，多个用逗号分隔,SHOW,EXPLAIN,DESCRIBE这三个SQL语法sqlglot解析不出来，先不支持了，后续需要单独做接口）
CHATDATA_ALLOWED_SQL=SELECT
# 查询结果行数限制（默认10000）
CHATDATA_ROW_LIMIT=10000
# MySQL 查询默认超时时间（秒）
CHAT_DATA_MYSQL_QUERY_TIMEOUT_SECONDS=60
# Hive 查询默认超时时间（秒）
CHAT_DATA_HIVE_QUERY_TIMEOUT_SECONDS=600
# 数据库连接超时（秒）
CHAT_DATA_DB_CONNECT_TIMEOUT_SECONDS=3
# Hive socket 读写超时（秒）
CHAT_DATA_HIVE_SOCKET_TIMEOUT_SECONDS=10
# 数据源同步任务总超时（秒）
CHAT_DATA_DATASOURCE_SYNC_TIMEOUT_SECONDS=30
# Hive 同步表结构最大并发
CHAT_DATA_HIVE_SCHEMA_MAX_WORKERS=10
# 看板面板批量执行最大并发数（默认 8）
CHAT_DATA_DASHBOARD_PANEL_MAX_CONCURRENCY=20
# MySQL 同步表结构和 SQL 查询用户
CHAT_DATA_MYSQL_USER=
# MySQL 同步表结构和 SQL 查询密码，SM4 加密后的密文
CHAT_DATA_MYSQL_PASSWORD=
# Hive 同步表结构和 SQL 查询用户
CHAT_DATA_HIVE_USER=
# Hive 同步表结构和 SQL 查询密码（可留空）
CHAT_DATA_HIVE_PASSWORD=
# ChatData 用户权限接口；HTTP 执行对象机构权限接口，未配置时 HTTP 执行对象不可见、不可执行
CHAT_DATA_HTTP_PERMISSION_URL=
# HTTP 执行对象机构权限接口超时（秒）
CHAT_DATA_HTTP_PERMISSION_TIMEOUT_SECONDS=5
# ChatData 任务提交接口
CHAT_DATA_HTTP_SUBMIT_URL=
# ChatData 状态查询接口，成功会返回结果
CHAT_DATA_HTTP_STATUS_URL=
# ChatData 停止接口
CHAT_DATA_HTTP_STOP_URL=
# 元数据 HTTP 模式：获取表名列表接口
CHAT_DATA_META_TABLES_URL=
# 元数据 HTTP 模式：获取完整表结构接口
CHAT_DATA_META_SCHEMA_URL=
# 元数据 HTTP 模式：单次请求超时（秒）
CHAT_DATA_META_TIMEOUT_SECONDS=30
# ChatData 认证token，SM4 加密后的密文，变量名保持不变
CHAT_DATA_HTTP_AUTH_TOKEN=
# ChatData 轮询间隔（毫秒）
CHAT_DATA_HTTP_POLL_INTERVAL_MS=5000
# ChatData 是否校验证书：true/false，默认 false
CHAT_DATA_HTTP_VERIFY_TLS=false
# SQL 查询结果缓存开关：true/false（默认 false）
CHAT_DATA_QUERY_CACHE_ENABLED=false
# SQL 查询结果缓存过期时间（秒，默认 3600）
CHAT_DATA_QUERY_CACHE_TTL_SECONDS=3600
# 同一用户查询同一执行数据源最大 SQL 并发数
CHAT_DATA_SQL_USER_DATASOURCE_MAX_CONCURRENCY=2
# 直连(direct)执行对象机构白名单，逗号分隔；直连对象不走 HTTP 权限服务，命中即放行
# 本地开发可在 conf/.env-dev 配置占位 org code；生产按需配置真实机构，留空则直连对象对所有用户不可见
CHAT_DATA_DIRECT_ORG_CODES=

# =============== 智能体定时任务调度 ===============
# 调度器总开关：true/false（默认 false），开启前需先建 chat_data_agent_schedule / chat_data_agent_schedule_run 表
CHAT_DATA_SCHEDULE_ENABLED=false
# 调度轮询间隔（秒，默认 30）
CHAT_DATA_SCHEDULE_POLL_SECONDS=30
# 每进程每轮最大派发的触发实例数（默认 10；全局并发上限 = 该值 × 节点数 × 每 talker 并发）
CHAT_DATA_SCHEDULE_DISPATCH_BATCH_SIZE=10
# 同一用户同时在途（已派发未收口）的定时执行上限（默认 2），超出排队等待
CHAT_DATA_SCHEDULE_USER_MAX_CONCURRENCY=2
# 错过触发窗口（秒，默认 3600）：停机/主库切换期间过期的触发点快进跳过，不补跑
CHAT_DATA_SCHEDULE_MISFIRE_WINDOW_SECONDS=3600
# 单个触发实例的最大派发尝试次数（默认 10；会话被占用等冲突每轮重试，耗尽置 skipped）
CHAT_DATA_SCHEDULE_MAX_DISPATCH_ATTEMPTS=10
# claimed 超时回收（秒，默认 300）：节点抢占后崩溃会悬挂 claimed，超时由其他节点释放回 pending
CHAT_DATA_SCHEDULE_CLAIM_TIMEOUT_SECONDS=300
# 单个用户可创建的定时任务上限（默认 20）
CHAT_DATA_SCHEDULE_MAX_JOBS_PER_USER=20

# =============== MCP / 插件（扩展能力） ===============
# MCP server **当前仅由插件声明**（plugin.json 的 mcp_servers），随插件安装/启停生效；
# 独立的 MCP server 挂载与管理页面后续提供（届时再引入部署级/DB 配置来源）。
# 字段：id（必填，工具名前缀）、transport（仅 streamable_http）、url/headers、
# tool_labels（展示名）、tool_approvals、enabled（false 不参与装配）。
# 注意：远程必须 https（loopback 例外），未通过准入会被跳过。
# 单次 MCP initialize/list_tools/call_tool 超时（秒，默认 60）
CHAT_DATA_MCP_TOOL_TIMEOUT_SECONDS=60
# 连接/initialize/discover 握手超时（秒），与工具调用超时分离
CHAT_DATA_MCP_CONNECT_TIMEOUT_SECONDS=15
# MCP 工具枚举缓存 TTL（秒，默认 300）：缓存期内 agent 装配不重复连接 MCP server
CHAT_DATA_MCP_TOOLS_CACHE_TTL_SECONDS=300
# ===== MCP 准入检查（admission gate；不满足要求的 server 不枚举/不挂载/不可检索） =====
# 远程 MCP 必须 https（loopback/127.0.0.1/localhost 例外，兼容本地诊断 server）
CHAT_DATA_MCP_REQUIRE_HTTPS=true
# 可选 host 白名单（逗号分隔，支持 *.example.com）；留空表示不限制 host。建议线上配置
# CHAT_DATA_MCP_ALLOWED_HOSTS=*.internal.example.com,127.0.0.1
CHAT_DATA_MCP_ALLOWED_HOSTS=
# 准入硬上限：单个 server 工具数、单工具 schema 字节数、单工具描述字符数（超限拒绝/告警）
CHAT_DATA_MCP_MAX_TOOLS_PER_SERVER=16
CHAT_DATA_MCP_MAX_TOOL_SCHEMA_BYTES=2048
CHAT_DATA_MCP_MAX_TOOL_DESCRIPTION_CHARS=1024
# Agent 装配的 MCP 工具两级加载策略（默认 auto）：off 全量挂载不检索；
# auto 工具 schema token 超过模型窗口 10% 才启用检索；forced 无条件启用检索模式
# （模型先调 mcp_tool_search 检索命中名单，再按名调用，每轮请求只暴露已发现工具）
# CHAT_DATA_AGENT_MCP_TOOL_SEARCH=auto
# 技能包插件根目录为 CHAT_DATA_HOME/plugins/<name>（plugin.json + skills/ + 可选 mcp_servers）；
# 管理接口：GET/POST /api/chatdata/admin/plugins（安装）、PUT .../{id}/enabled、DELETE .../{id}。

# =============== 沙箱配置（OpenSandbox，仅 sandbox 后端使用） ===============
# 沙箱执行后端已内部固定为 OpenSandbox，不再作为配置项（WORKSPACE_EXECUTION_BACKEND 已移除）。
OPENSANDBOX_URL=
# OpenSandbox API Key，SM4 加密后的密文；留空表示不传 API Key
OPENSANDBOX_API_KEY=
# 沙箱不访问应用节点的 CHAT_DATA_HOME，也不使用宿主机目录挂载。
# 应用通过 OpenSandbox Files API 上传会话快照，变更后的 workspace/outputs 再下载回应用侧。
# 沙箱内虚拟路径固定为 /mnt/user-data 和 /mnt/skills。
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_IMAGE=ubuntu-chatdata:22.04-amd64
OPENSANDBOX_NETWORK_DEFAULT_ACTION=deny
# 沙箱实例存活时间，不是控制面请求超时
OPENSANDBOX_TIMEOUT_SECONDS=900
# 模型调用前后续期沙箱（每轮模型调用续到 now+timeout）；false 关闭
OPENSANDBOX_RENEW_ENABLED=true
# OpenSandbox 控制面单次 HTTP 请求超时
OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=10
# Sandbox.create 总超时，覆盖创建、endpoint 获取和健康等待
OPENSANDBOX_CREATE_TIMEOUT_SECONDS=100
OPENSANDBOX_READY_TIMEOUT_SECONDS=60

# ---- mcp_servers（自维护 MCP server 进程，plugins/fault-analysis 声明） ----
# MCP_DB_QUERY_PORT=3001
# MCP_SSH_EXEC_PORT=3002
# 目标数据库只读账号（db_query action 连接目标库时使用）
# MCP_DIAG_DB_USER=omind_readonly
# MCP_DIAG_DB_PASSWORD=
# SSH 默认连接参数（ssh_exec action 连接目标机时使用）
# MCP_DIAG_SSH_PORT=22
# MCP_DIAG_SSH_USERNAME=root
# MCP_DIAG_SSH_KEY_FILE=~/.ssh/id_rsa
