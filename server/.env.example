# =============== 服务配置 ===============
# 端口
PORT=5001
# 全局数据根目录（可选，默认 ./server/uploads）
DATA_ROOT=
# 开启热更新
FASTAPI_RELOAD=false
# Gunicorn worker 数量，生产启动 gunicorn main:app -c gunicorn.conf.py 时生效
GUNICORN_WORKERS=4
# Gunicorn worker 超时时间（秒），智能体/SQL/沙箱请求可能较长
GUNICORN_TIMEOUT=900
# Gunicorn 优雅退出等待时间（秒）
GUNICORN_GRACEFUL_TIMEOUT=30
# Gunicorn keepalive 时间（秒）
GUNICORN_KEEPALIVE=5
# =============== 日志配置 ===============
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志文件目录（相对或绝对路径）
LOG_DIR=logs
# 日志应用名，同时作为日志文件名前缀；默认生成 data-agent_app.log / data-agent_acc.log / data-agent_alarm.log
LOG_APP_NAME=data-agent
# 是否输出到控制台：true/false（DEBUG模式自动开启）
LOG_CONSOLE=true
# 说明：日志每天凌晨自动切割，切割后文件名如 data-agent_app.log.2025-11-12，默认保留最近30天

# =============== 加密配置 ===============
# 进入目录: cd server
# 生成密钥: python -c "import os; print(os.urandom(16).hex())"
# 加密密码: ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto encrypt "{password}"
# 解密密码: ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto decrypt "{ciphertext}"
ENCRYPT_KEY=

# =============== 数据库配置 ===============
# 智能体历史会话保存数据库配置：sqlite/mysql
CHECKPOINTER_TYPE=sqlite
# 支持单节点或多节点 host:port 列表；每个节点都必须显式写端口
# 示例：CHECKPOINTER_HOST=10.0.0.1:3306,10.0.0.2:3307,10.0.0.3:3306
CHECKPOINTER_HOST=
CHECKPOINTER_DB=langchain_checkpoint
CHECKPOINTER_USER=
CHECKPOINTER_PASSWORD=

# 业务数据库配置
# 支持单节点或多节点 host:port 列表；每个节点都必须显式写端口
# 示例：FXCJG_DB_HOST=10.0.0.1:3306,10.0.0.2:3307,10.0.0.3:3306
FXCJG_DB_HOST=
FXCJG_DB=fxcjg_ai
FXCJG_DB_USER=
FXCJG_DB_PASSWORD=

# =============== 智能问数模型配置 ===============
# SM4 加密后的 API Key，变量名保持不变。生成方式：
# ENCRYPT_KEY={ENCRYPT_KEY} python -m utils.crypto encrypt "{api_key}"
CHAT_DATA_API_KEY=
CHAT_DATA_BASE_URL=https://api.openai.com/v1
# 模型配置：模型名;温度;上下文窗口，多个模型用逗号分隔，第一项为默认模型
CHAT_DATA_MODEL="gpt-4o-mini;0.2;128000"
# 是否开启智能分析
CHAT_DATA_ANALYZE_ENABLED=true

# =============== ChatData SQL 执行配置 ===============
# 工具结果超过该字符数时写入 artifact，避免大结果进入大模型上下文（默认 32000）
CHATDATA_TOOL_RESULT_OFFLOAD_SIZE=32000
# 模型入口上下文编辑开关；只影响发送给大模型的上下文，不影响页面历史和 checkpoint
CHATDATA_CONTEXT_EDIT_ENABLED=true
# SQL 安全限制（多个用逗号分隔）
CHATDATA_ALLOWED_SQL=SELECT
# 查询结果行数限制
CHATDATA_ROW_LIMIT=100
# 智能问数 SQL 执行是否使用异步查询任务和 LangGraph 恢复机制
CHAT_DATA_AGENT_SQL_ASYNC_ENABLED=true
# MySQL 查询默认超时时间（秒）
CHAT_DATA_MYSQL_QUERY_TIMEOUT_SECONDS=60
# Hive 查询默认超时时间（秒）
CHAT_DATA_HIVE_QUERY_TIMEOUT_SECONDS=600
# 数据库连接超时（秒）
CHAT_DATA_DB_CONNECT_TIMEOUT_SECONDS=3
# Hive socket 读写超时（秒）
CHAT_DATA_HIVE_SOCKET_TIMEOUT_SECONDS=10
# 数据源同步任务总超时（秒）
CHAT_DATA_DATASOURCE_SYNC_TIMEOUT_SECONDS=30
# Hive 同步表结构最大并发
CHAT_DATA_HIVE_SCHEMA_MAX_WORKERS=10
# 看板面板批量执行最大并发数
CHAT_DATA_DASHBOARD_PANEL_MAX_CONCURRENCY=8
# 同一用户查询同一执行数据源最大 SQL 并发数
CHAT_DATA_SQL_USER_DATASOURCE_MAX_CONCURRENCY=2

# =============== 智能分析 OpenSandbox 执行配置 ===============
# 沙箱类型，目前仅支持 opensandbox
WORKSPACE_EXECUTION_BACKEND=opensandbox
OPENSANDBOX_URL=
# OpenSandbox API Key，SM4 加密后的密文；留空表示不传 API Key
OPENSANDBOX_API_KEY=
OPENSANDBOX_WORKSPACE_ROOT=/mnt
OPENSANDBOX_WORKSPACE_SYNC_MODE=remote-host-volume
OPENSANDBOX_HOST_WORKSPACE_ROOT=/data/opensandbox-workspaces
OPENSANDBOX_HOST_PROJECT_NAME=data-agent
OPENSANDBOX_USE_SERVER_PROXY=false
OPENSANDBOX_IMAGE=omind-sandbox:0.1-amd64
OPENSANDBOX_NETWORK_DEFAULT_ACTION=deny
OPENSANDBOX_TIMEOUT_SECONDS=600
OPENSANDBOX_READY_TIMEOUT_SECONDS=60
OPENSANDBOX_PYTHON_BIN=python3

# =============== 表结构与查询账号配置 ===============
# 表结构获取方式：cache（从缓存读取，默认）或 live（实时从数据库获取）
CHAT_DATA_SCHEMA_SOURCE=cache
# MySQL 同步表结构和 SQL 查询用户
CHAT_DATA_MYSQL_USER=
# MySQL 同步表结构和 SQL 查询密码
CHAT_DATA_MYSQL_PASSWORD=
# Hive 同步表结构和 SQL 查询用户
CHAT_DATA_HIVE_USER=
# Hive 同步表结构和 SQL 查询密码（可留空）
CHAT_DATA_HIVE_PASSWORD=

# =============== ChatData HTTP 查询与元数据接口 ===============
# ChatData 任务提交接口
CHAT_DATA_HTTP_SUBMIT_URL=
# ChatData 状态查询接口，成功会返回结果
CHAT_DATA_HTTP_STATUS_URL=
# ChatData 停止接口
CHAT_DATA_HTTP_STOP_URL=
# 元数据 HTTP 模式：获取表名列表接口
CHAT_DATA_META_TABLES_URL=
# 元数据 HTTP 模式：获取完整表结构接口
CHAT_DATA_META_SCHEMA_URL=
# 元数据 HTTP 模式：单次请求超时（秒）
CHAT_DATA_META_TIMEOUT_SECONDS=30
# ChatData HTTP 认证 token，SM4 加密后的密文，变量名保持不变
CHAT_DATA_HTTP_AUTH_TOKEN=
# ChatData 轮询间隔（毫秒）
CHAT_DATA_HTTP_POLL_INTERVAL_MS=1500
# ChatData 是否校验证书：true/false
CHAT_DATA_HTTP_VERIFY_TLS=false

# =============== SQL 查询结果缓存 ===============
# SQL 查询结果缓存开关：true/false
CHAT_DATA_QUERY_CACHE_ENABLED=false
# SQL 查询结果缓存过期时间（秒）
CHAT_DATA_QUERY_CACHE_TTL_SECONDS=3600

# =============== 服务转发认证 ===============
# 服务转发认证令牌，SM4 加密后的密文；明文会启动失败。解密后的值需与 web-vue/.env 的 AGENT_SERVICE_TOKEN 一致
SERVICE_AUTH_TOKEN=
