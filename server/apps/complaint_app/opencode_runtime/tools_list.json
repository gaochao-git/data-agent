[
  {
    "name": "complaint_analysis",
    "kind": "tool",
    "description": "举报事项分析工具（基于专家经验库）：识别举报事项并给出综合分析结论。source_text 应为摘要或用户选中内容；若无摘要需先生成摘要。不适用于“仅使用本地 laws/本地法律法规”类任务。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "用户问题"
        },
        "source_text": {
          "type": "string",
          "description": "摘要内容或用户选中的内容"
        }
      },
      "required": [
        "query",
        "source_text"
      ]
    }
  },
  {
    "name": "complaint_text_extract",
    "kind": "tool",
    "description": "举报件附件文本提取工具：从上传文件或已有会话中提取原文文本。",
    "parameters": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "用户ID（用于文件存储路径）"
        },
        "input_file_path": {
          "type": "string",
          "description": "本地文件路径（pdf/png/jpg）"
        },
        "file_path": {
          "type": "string",
          "description": "本地文件路径（input_file_path 的别名）"
        },
        "upload_display_name": {
          "type": "string",
          "description": "上传文件显示名（可选）"
        },
        "base_id": {
          "type": "string",
          "description": "会话ID（复用已有原件时使用）"
        },
        "reuse_existing_original": {
          "type": "boolean",
          "description": "是否复用已存在的原件（需配合 base_id）"
        }
      },
      "required": []
    }
  },
  {
    "name": "shell",
    "kind": "tool",
    "description": "Execute a shell command and return its output. READ ONLY operations allowed.",
    "parameters": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command to execute"
        }
      },
      "required": [
        "command"
      ]
    }
  },
  {
    "name": "skill",
    "kind": "skill",
    "description": "Load a skill to get detailed instructions for a specific task.\nSkills provide specialized knowledge and step-by-step guidance.\nUse this when a task matches an available skill's description.\nOnly the skills listed here are available:\n<available_skills>\n<skill>\n<name>\ncomplaint-law-analysis\n</name>\n<description>\nAnalyze举报事项 based only on local laws; match case facts to legal obligations, note time applicability, and produce cited findings and evidence requests.\n</description>\n<location>\n/Users/fengyingsheng/workspaces/personal/fxcjg/fxcjg/server/apps/complaint_app/opencode_runtime/skills/.complaint_skills/complaint-law-analysis/SKILL.md\n</location>\n</skill>\n<skill>\n<name>\nskill-creator\n</name>\n<description>\nGuide for creating effective skills. This skill should be used when users want to create a new skill (or update an existing skill) that extends complaint&#x27;s capabilities with specialized knowledge, workflows, or tool integrations.\n</description>\n<location>\n/Users/fengyingsheng/workspaces/personal/fxcjg/fxcjg/server/apps/complaint_app/opencode_runtime/skills/.complaint_skills/skill-creator/SKILL.md\n</location>\n</skill>\n<skill>\n<name>\nskill-installer\n</name>\n<description>\nInstall Complaints skills into $Complaints_HOME/skills from a curated list or a GitHub repo path. Use when a user asks to list installable skills, install a curated skill, or install a skill from another repo (including private repos).\n</description>\n<location>\n/Users/fengyingsheng/workspaces/personal/fxcjg/fxcjg/server/apps/complaint_app/opencode_runtime/skills/.complaint_skills/skill-installer/SKILL.md\n</location>\n</skill>\n</available_skills>",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "skill identifier from available_skills"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  {
    "name": "task",
    "kind": "agent",
    "description": "Call a specialized subagent to handle a task.\n\nAvailable subagents:\n- complaint_summary: 举报件摘要智能体，根据举报件原文生成举报件摘要，包括举报人、被举报人、事情经过、举报事项等信息",
    "parameters": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "A short (3-5 words) description of the task"
        },
        "prompt": {
          "type": "string",
          "description": "The task for the agent to perform"
        },
        "source_text": {
          "type": "string",
          "description": "Source text used by the subagent (optional)"
        },
        "subagent_type": {
          "type": "string",
          "description": "The type of specialized agent to use for this task"
        },
        "session_id": {
          "type": "string",
          "description": "Existing task session to continue"
        },
        "command": {
          "type": "string",
          "description": "The command that triggered this task"
        }
      },
      "required": [
        "description",
        "prompt",
        "subagent_type"
      ]
    }
  },
  {
    "name": "pbc.hybrid_search",
    "kind": "tool",
    "description": "混合检索：关键词 + 语义（占位）+ 元数据过滤。",
    "parameters": {
      "$defs": {
        "HybridMetaFilter": {
          "properties": {
            "issuing_authority": {
              "items": {
                "type": "string"
              },
              "title": "Issuing Authority",
              "type": "array"
            },
            "status": {
              "items": {
                "type": "string"
              },
              "title": "Status",
              "type": "array"
            },
            "law_level": {
              "items": {
                "type": "string"
              },
              "title": "Law Level",
              "type": "array"
            },
            "date_range": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Date Range",
              "type": "object"
            }
          },
          "title": "HybridMetaFilter",
          "type": "object"
        }
      },
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "top_k": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 20,
          "title": "Top K"
        },
        "use_bm25": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Use Bm25"
        },
        "use_vector": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Use Vector"
        },
        "meta_filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/HybridMetaFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "query"
      ],
      "title": "hybrid_searchArguments",
      "type": "object"
    }
  },
  {
    "name": "pbc.get_provision_context",
    "kind": "tool",
    "description": "为命中的条款提供上下文（相邻条款、定义、例外、引用等）。",
    "parameters": {
      "properties": {
        "law_id": {
          "title": "Law Id",
          "type": "string"
        },
        "article_id": {
          "title": "Article Id",
          "type": "string"
        },
        "include_neighbors": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Include Neighbors"
        },
        "neighbor_range": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "title": "Neighbor Range"
        },
        "include_definitions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Include Definitions"
        },
        "include_exceptions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Include Exceptions"
        },
        "include_references": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Include References"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2000,
          "title": "Max Length"
        }
      },
      "required": [
        "law_id",
        "article_id"
      ],
      "title": "get_provision_contextArguments",
      "type": "object"
    }
  },
  {
    "name": "pbc.get_law",
    "kind": "tool",
    "description": "获取法规的元数据与正文。",
    "parameters": {
      "$defs": {
        "LawRange": {
          "properties": {
            "type": {
              "enum": [
                "all",
                "chapter",
                "section",
                "articles",
                "article_ids"
              ],
              "title": "Type",
              "type": "string"
            },
            "value": {
              "additionalProperties": true,
              "title": "Value",
              "type": "object"
            }
          },
          "title": "LawRange",
          "type": "object"
        }
      },
      "properties": {
        "law_id": {
          "title": "Law Id",
          "type": "string"
        },
        "article_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article Ids"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/LawRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "structured",
                "plain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "structured",
          "title": "Format"
        }
      },
      "required": [
        "law_id"
      ],
      "title": "get_lawArguments",
      "type": "object"
    }
  },
  {
    "name": "pbc.meta_schema",
    "kind": "tool",
    "description": "返回可用于过滤/查询的元数据字段及其描述。",
    "parameters": {
      "properties": {},
      "title": "meta_schemaArguments",
      "type": "object"
    }
  }
]