PREFIX ex: <http://example.com/zhidu-clause-semantics/>

# Query 1: 同主体+同动作+同对象，但约束不同（跨制度，高召回版）
SELECT ?docId1 ?title1 ?articleNo1 ?docId2 ?title2 ?articleNo2 ?subject ?action ?object ?constraint1 ?constraint2 ?evidence1 ?evidence2
WHERE {
  {
    SELECT ?doc1 ?c1 ?r1 ?docId1 ?doc2 ?c2 ?r2 ?docId2 ?subject ?action ?object ?constraint1 ?constraint2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      ?doc1 ex:documentId ?docId1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(?constraint1 != ?constraint2)
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?constraint1 ?constraint2
    LIMIT 200
  }
  ?doc1 ex:title ?title1 .
  ?doc2 ex:title ?title2 .
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
  OPTIONAL { ?r1 ex:evidenceText ?e1raw . }
  OPTIONAL { ?c1 ex:articleText ?articleText1 . }
  OPTIONAL { ?r2 ex:evidenceText ?e2raw . }
  OPTIONAL { ?c2 ex:articleText ?articleText2 . }
  BIND(IF(BOUND(?e1raw), ?e1raw, IF(BOUND(?articleText1), ?articleText1, "")) AS ?evidence1)
  BIND(IF(BOUND(?e2raw), ?e2raw, IF(BOUND(?articleText2), ?articleText2, "")) AS ?evidence2)
}


# Query 2: 同主体+同动作+同对象，但条件不同（跨制度）
SELECT ?docId1 ?title1 ?articleNo1 ?docId2 ?title2 ?articleNo2 ?subject ?action ?object ?cond1 ?cond2 ?evidence1 ?evidence2
WHERE {
  {
    SELECT ?doc1 ?c1 ?r1 ?docId1 ?doc2 ?c2 ?r2 ?docId2 ?subject ?action ?object ?cond1 ?cond2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      OPTIONAL { ?r1 ex:hasCondition ?d1 . ?d1 ex:canonicalName ?cond1 . }
      OPTIONAL { ?r2 ex:hasCondition ?d2 . ?d2 ex:canonicalName ?cond2 . }
      ?doc1 ex:documentId ?docId1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER((BOUND(?cond1) || BOUND(?cond2)) && (!BOUND(?cond1) || !BOUND(?cond2) || ?cond1 != ?cond2))
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?cond1 ?cond2
    LIMIT 200
  }
  ?doc1 ex:title ?title1 .
  ?doc2 ex:title ?title2 .
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
  OPTIONAL { ?r1 ex:evidenceText ?e1raw . }
  OPTIONAL { ?c1 ex:articleText ?articleText1 . }
  OPTIONAL { ?r2 ex:evidenceText ?e2raw . }
  OPTIONAL { ?c2 ex:articleText ?articleText2 . }
  BIND(IF(BOUND(?e1raw), ?e1raw, IF(BOUND(?articleText1), ?articleText1, "")) AS ?evidence1)
  BIND(IF(BOUND(?e2raw), ?e2raw, IF(BOUND(?articleText2), ?articleText2, "")) AS ?evidence2)
}


# Query 3: “义务” vs “禁止”对冲候选（跨制度）
SELECT ?docId1 ?articleNo1 ?docId2 ?articleNo2 ?subject ?action ?object ?c1 ?c2
WHERE {
  {
    SELECT ?docId1 ?cl1 ?docId2 ?cl2 ?subject ?action ?object ?c1 ?c2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      ?k1 ex:canonicalName ?c1 . ?k2 ex:canonicalName ?c2 .
      ?doc1 ex:documentId ?docId1 ; ex:hasClause ?cl1 .
      ?cl1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:hasClause ?cl2 .
      ?cl2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(REGEX(?c1, "应当|必须"))
      FILTER(REGEX(?c2, "不得|禁止"))
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?c1 ?c2
    LIMIT 200
  }
  ?cl1 ex:articleNo ?articleNo1 .
  ?cl2 ex:articleNo ?articleNo2 .
}


# Query 4: 组间冲突候选（不同版块）
SELECT ?board1 ?docId1 ?articleNo1 ?board2 ?docId2 ?articleNo2 ?subject ?action ?constraint1 ?constraint2
WHERE {
  {
    SELECT ?board1 ?docId1 ?c1 ?board2 ?docId2 ?c2 ?subject ?action ?constraint1 ?constraint2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      ?doc1 ex:documentId ?docId1 ; ex:board ?board1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:board ?board2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(?board1 != ?board2)
      FILTER(?constraint1 != ?constraint2)
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?constraint1 ?constraint2
    LIMIT 200
  }
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
}


# Query 5: 组内自冲突候选（同制度内）
SELECT ?docId ?title ?articleNo1 ?articleNo2 ?subject ?action ?object ?constraint1 ?constraint2 ?evidence1 ?evidence2
WHERE {
  {
    SELECT ?doc ?docId ?c1 ?r1 ?c2 ?r2 ?subject ?action ?object ?constraint1 ?constraint2
    WHERE {
      ?doc ex:documentId ?docId ; ex:hasClause ?c1, ?c2 .
      FILTER(?c1 != ?c2)
      ?c1 ex:articleNo ?articleNo1 ; ex:expressesRule ?r1 .
      ?c2 ex:articleNo ?articleNo2 ; ex:expressesRule ?r2 .
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      FILTER(?articleNo1 < ?articleNo2)
      FILTER(?constraint1 != ?constraint2)
    }
    ORDER BY ?docId ?subject ?action ?object ?constraint1 ?constraint2
    LIMIT 200
  }
  ?doc ex:title ?title .
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
  OPTIONAL { ?r1 ex:evidenceText ?e1raw . }
  OPTIONAL { ?c1 ex:articleText ?articleText1 . }
  OPTIONAL { ?r2 ex:evidenceText ?e2raw . }
  OPTIONAL { ?c2 ex:articleText ?articleText2 . }
  BIND(IF(BOUND(?e1raw), ?e1raw, IF(BOUND(?articleText1), ?articleText1, "")) AS ?evidence1)
  BIND(IF(BOUND(?e2raw), ?e2raw, IF(BOUND(?articleText2), ?articleText2, "")) AS ?evidence2)
}


# Query 6: 时间/金额阈值冲突候选（数值级）
SELECT ?docId1 ?articleNo1 ?docId2 ?articleNo2 ?subject ?action ?object ?constraint1 ?constraint2
WHERE {
  {
    SELECT ?docId1 ?c1 ?docId2 ?c2 ?subject ?action ?object ?constraint1 ?constraint2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      ?doc1 ex:documentId ?docId1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(?constraint1 != ?constraint2)
      FILTER(REGEX(?constraint1, "[0-9０-９一二三四五六七八九十百千万亿]+|工作日|日|月|年|小时|分钟|元|万元|亿元|%"))
      FILTER(REGEX(?constraint2, "[0-9０-９一二三四五六七八九十百千万亿]+|工作日|日|月|年|小时|分钟|元|万元|亿元|%"))
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?constraint1 ?constraint2
    LIMIT 200
  }
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
}


# Query 7: 适用范围冲突候选（对象边界）
SELECT ?docId1 ?articleNo1 ?docId2 ?articleNo2 ?subject ?action ?object ?condition1 ?condition2 ?constraint1 ?constraint2
WHERE {
  {
    SELECT ?docId1 ?c1 ?docId2 ?c2 ?subject ?action ?object ?condition1 ?condition2 ?constraint1 ?constraint2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      OPTIONAL { ?r1 ex:hasCondition ?d1 . ?d1 ex:canonicalName ?condition1 . }
      OPTIONAL { ?r2 ex:hasCondition ?d2 . ?d2 ex:canonicalName ?condition2 . }
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      ?doc1 ex:documentId ?docId1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(
        REGEX(CONCAT(COALESCE(?condition1, ""), " ", ?constraint1), "适用|仅限|限于|范围|不包括|包括|除外|范围内|范围外")
        || REGEX(CONCAT(COALESCE(?condition2, ""), " ", ?constraint2), "适用|仅限|限于|范围|不包括|包括|除外|范围内|范围外")
      )
      FILTER(
        REGEX(CONCAT(COALESCE(?condition1, ""), " ", ?constraint1), "不|不得|除外|不包括")
        || REGEX(CONCAT(COALESCE(?condition2, ""), " ", ?constraint2), "不|不得|除外|不包括")
      )
      FILTER(CONCAT(COALESCE(?condition1, ""), " ", ?constraint1) != CONCAT(COALESCE(?condition2, ""), " ", ?constraint2))
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?constraint1 ?constraint2
    LIMIT 200
  }
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
}


# Query 8: 一般条款 vs 特别条款冲突候选
SELECT ?docId1 ?articleNo1 ?docId2 ?articleNo2 ?subject ?action ?object ?condition1 ?condition2 ?constraint1 ?constraint2
WHERE {
  {
    SELECT ?docId1 ?c1 ?docId2 ?c2 ?subject ?action ?object ?condition1 ?condition2 ?constraint1 ?constraint2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      OPTIONAL { ?r1 ex:hasCondition ?d1 . ?d1 ex:canonicalName ?condition1 . }
      OPTIONAL { ?r2 ex:hasCondition ?d2 . ?d2 ex:canonicalName ?condition2 . }
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      ?doc1 ex:documentId ?docId1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(
        (REGEX(COALESCE(?condition1, ""), "一般|通常|原则上") && REGEX(COALESCE(?condition2, ""), "特别|特殊|例外|除.*外"))
        || (REGEX(COALESCE(?condition2, ""), "一般|通常|原则上") && REGEX(COALESCE(?condition1, ""), "特别|特殊|例外|除.*外"))
      )
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?condition1 ?condition2
    LIMIT 200
  }
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
}


# Query 9: 上位/下位规则豁免候选
SELECT ?docId1 ?docLevel1 ?articleNo1 ?docId2 ?docLevel2 ?articleNo2 ?subject ?action ?object ?constraint1 ?constraint2
WHERE {
  {
    SELECT ?docId1 ?docLevel1 ?c1 ?docId2 ?docLevel2 ?c2 ?subject ?action ?object ?constraint1 ?constraint2
    WHERE {
      ?r1 a ex:RuleExpression ; ex:hasSubject ?s1 ; ex:hasAction ?a1 ; ex:hasObject ?o1 ; ex:hasConstraint ?k1 .
      ?r2 a ex:RuleExpression ; ex:hasSubject ?s2 ; ex:hasAction ?a2 ; ex:hasObject ?o2 ; ex:hasConstraint ?k2 .
      ?s1 ex:canonicalName ?subject . ?s2 ex:canonicalName ?subject .
      ?a1 ex:canonicalName ?action . ?a2 ex:canonicalName ?action .
      ?o1 ex:canonicalName ?object . ?o2 ex:canonicalName ?object .
      ?k1 ex:canonicalName ?constraint1 . ?k2 ex:canonicalName ?constraint2 .
      ?doc1 ex:documentId ?docId1 ; ex:docLevel ?docLevel1 ; ex:hasClause ?c1 .
      ?c1 ex:expressesRule ?r1 .
      ?doc2 ex:documentId ?docId2 ; ex:docLevel ?docLevel2 ; ex:hasClause ?c2 .
      ?c2 ex:expressesRule ?r2 .
      FILTER(?docId1 < ?docId2)
      FILTER(?docLevel1 != ?docLevel2)
      FILTER(
        REGEX(?constraint1, "不适用|豁免|除外|从其规定|按上位规定|依照.*办法|依据.*办法")
        || REGEX(?constraint2, "不适用|豁免|除外|从其规定|按上位规定|依照.*办法|依据.*办法")
      )
    }
    ORDER BY ?docId1 ?docId2 ?subject ?action ?object ?constraint1 ?constraint2
    LIMIT 200
  }
  ?c1 ex:articleNo ?articleNo1 .
  ?c2 ex:articleNo ?articleNo2 .
}
