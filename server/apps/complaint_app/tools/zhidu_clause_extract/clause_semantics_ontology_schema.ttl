@prefix ex: <http://example.com/zhidu-clause-semantics/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ClauseSemanticsOntology a owl:Ontology ;
    rdfs:label "制度条款语义本体"@zh .

##########
# 类定义
##########

ex:PolicyDocument a owl:Class ;
    rdfs:label "制度文档"@zh .

ex:Clause a owl:Class ;
    rdfs:label "条款"@zh .

ex:RuleExpression a owl:Class ;
    rdfs:label "规制表达"@zh .

ex:Concept a owl:Class ;
    rdfs:label "概念"@zh .

ex:SubjectConcept a owl:Class ;
    rdfs:subClassOf ex:Concept ;
    rdfs:label "主体概念"@zh .

ex:ActionConcept a owl:Class ;
    rdfs:subClassOf ex:Concept ;
    rdfs:label "动作概念"@zh .

ex:ObjectConcept a owl:Class ;
    rdfs:subClassOf ex:Concept ;
    rdfs:label "对象概念"@zh .

ex:ConditionConcept a owl:Class ;
    rdfs:subClassOf ex:Concept ;
    rdfs:label "条件概念"@zh .

ex:ConstraintConcept a owl:Class ;
    rdfs:subClassOf ex:Concept ;
    rdfs:label "约束概念"@zh .

ex:ContextConcept a owl:Class ;
    rdfs:subClassOf ex:Concept ;
    rdfs:label "上下文概念"@zh .

##########
# 对象属性定义
##########

ex:hasClause a owl:ObjectProperty ;
    rdfs:label "包含条款"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range ex:Clause .

ex:belongsToDocument a owl:ObjectProperty ;
    rdfs:label "属于制度文档"@zh ;
    rdfs:domain ex:Clause ;
    rdfs:range ex:PolicyDocument .

ex:expressesRule a owl:ObjectProperty ;
    rdfs:label "表达规制单元"@zh ;
    rdfs:domain ex:Clause ;
    rdfs:range ex:RuleExpression .

ex:supportedByClause a owl:ObjectProperty ;
    rdfs:label "来源条款"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:Clause .

ex:hasSubject a owl:ObjectProperty ;
    rdfs:label "有关联主体概念"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:SubjectConcept .

ex:hasAction a owl:ObjectProperty ;
    rdfs:label "有关联动作概念"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:ActionConcept .

ex:hasObject a owl:ObjectProperty ;
    rdfs:label "有关联对象概念"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:ObjectConcept .

ex:hasCondition a owl:ObjectProperty ;
    rdfs:label "有关联条件概念"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:ConditionConcept .

ex:hasConstraint a owl:ObjectProperty ;
    rdfs:label "有关联约束概念"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:ConstraintConcept .

ex:hasBusinessContext a owl:ObjectProperty ;
    rdfs:label "有关联业务语境概念"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range ex:ContextConcept .

ex:hasBroaderConcept a owl:ObjectProperty ;
    rdfs:label "有上位概念"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range ex:Concept .

ex:hasNarrowerConcept a owl:ObjectProperty ;
    rdfs:label "有下位概念"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range ex:Concept .

ex:hasRelatedConcept a owl:ObjectProperty ;
    rdfs:label "有关联概念"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range ex:Concept .

##########
# 数据属性定义
##########

ex:documentId a owl:DatatypeProperty ;
    rdfs:label "文档ID"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:title a owl:DatatypeProperty ;
    rdfs:label "标题"@zh ;
    rdfs:range xsd:string .

ex:board a owl:DatatypeProperty ;
    rdfs:label "版块"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:domainName a owl:DatatypeProperty ;
    rdfs:label "领域"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:docNo a owl:DatatypeProperty ;
    rdfs:label "制度文号"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:docLevel a owl:DatatypeProperty ;
    rdfs:label "制度级别"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:publishDate a owl:DatatypeProperty ;
    rdfs:label "发布时间"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:ownerDepartment a owl:DatatypeProperty ;
    rdfs:label "主责部门"@zh ;
    rdfs:domain ex:PolicyDocument ;
    rdfs:range xsd:string .

ex:clauseKey a owl:DatatypeProperty ;
    rdfs:label "条款主键"@zh ;
    rdfs:domain ex:Clause ;
    rdfs:range xsd:string .

ex:articleNo a owl:DatatypeProperty ;
    rdfs:label "条号"@zh ;
    rdfs:domain ex:Clause ;
    rdfs:range xsd:string .

ex:articleText a owl:DatatypeProperty ;
    rdfs:label "条款文本"@zh ;
    rdfs:domain ex:Clause ;
    rdfs:range xsd:string .

ex:canonicalName a owl:DatatypeProperty ;
    rdfs:label "规范名称"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:aliasText a owl:DatatypeProperty ;
    rdfs:label "别名"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:mentionCategory a owl:DatatypeProperty ;
    rdfs:label "提及类别"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:conceptStatus a owl:DatatypeProperty ;
    rdfs:label "概念状态"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:ontologyRole a owl:DatatypeProperty ;
    rdfs:label "本体角色"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:definitionText a owl:DatatypeProperty ;
    rdfs:label "概念定义"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:screenReason a owl:DatatypeProperty ;
    rdfs:label "概念筛选理由"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:normalizationReason a owl:DatatypeProperty ;
    rdfs:label "归并理由"@zh ;
    rdfs:domain ex:Concept ;
    rdfs:range xsd:string .

ex:effectText a owl:DatatypeProperty ;
    rdfs:label "规制结果"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range xsd:string .

ex:evidenceText a owl:DatatypeProperty ;
    rdfs:label "证据文本"@zh ;
    rdfs:domain ex:RuleExpression ;
    rdfs:range xsd:string .
