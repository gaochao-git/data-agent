@prefix ex: <http://example.com/complaint-ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:InvestmentConflictOntology a owl:Ontology ;
    rdfs:label "制度冲突分析试点本体示例"@zh .

##########
# 类定义
##########

ex:Article a owl:Class ;
    rdfs:label "条"@zh .

ex:Item a owl:Class ;
    rdfs:label "项"@zh .

ex:NormUnit a owl:Class ;
    rdfs:label "规范单元"@zh .

ex:Topic a owl:Class ;
    rdfs:label "主题"@zh .

ex:SubjectRole a owl:Class ;
    rdfs:label "主体角色"@zh .

ex:Action a owl:Class ;
    rdfs:label "行为"@zh .

ex:ObjectEntity a owl:Class ;
    rdfs:label "作用对象"@zh .

ex:Modality a owl:Class ;
    rdfs:label "约束方式"@zh .

ex:Stage a owl:Class ;
    rdfs:label "流程阶段"@zh .

ex:Threshold a owl:Class ;
    rdfs:label "阈值"@zh .

##########
# 对象属性定义
##########

ex:hasChild a owl:ObjectProperty ;
    rdfs:label "有子节点"@zh ;
    rdfs:domain ex:Article ;
    rdfs:range ex:Item .

ex:derivedFrom a owl:ObjectProperty ;
    rdfs:label "来源于"@zh .

ex:hasNormUnit a owl:ObjectProperty ;
    rdfs:label "有规范单元"@zh ;
    rdfs:domain ex:Article ;
    rdfs:range ex:NormUnit .

ex:hasTopic a owl:ObjectProperty ;
    rdfs:label "有主题"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:Topic .

ex:hasSubject a owl:ObjectProperty ;
    rdfs:label "有主体"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:SubjectRole .

ex:hasAction a owl:ObjectProperty ;
    rdfs:label "有行为"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:Action .

ex:hasObject a owl:ObjectProperty ;
    rdfs:label "有作用对象"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:ObjectEntity .

ex:hasModality a owl:ObjectProperty ;
    rdfs:label "有约束方式"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:Modality .

ex:hasStage a owl:ObjectProperty ;
    rdfs:label "有阶段"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:Stage .

ex:hasThreshold a owl:ObjectProperty ;
    rdfs:label "有关联阈值"@zh ;
    rdfs:domain ex:NormUnit ;
    rdfs:range ex:Threshold .

##########
# 数据属性定义
##########

ex:labelText a owl:DatatypeProperty ;
    rdfs:label "编号文本"@zh .

ex:titleText a owl:DatatypeProperty ;
    rdfs:label "标题文本"@zh .

ex:rawText a owl:DatatypeProperty ;
    rdfs:label "原文"@zh .

ex:pageStart a owl:DatatypeProperty ;
    rdfs:label "起始页"@zh ;
    rdfs:range xsd:integer .

ex:pageEnd a owl:DatatypeProperty ;
    rdfs:label "结束页"@zh ;
    rdfs:range xsd:integer .

ex:metric a owl:DatatypeProperty ;
    rdfs:label "阈值指标"@zh .

ex:operator a owl:DatatypeProperty ;
    rdfs:label "阈值操作符"@zh .

ex:value a owl:DatatypeProperty ;
    rdfs:label "阈值数值"@zh .

ex:unit a owl:DatatypeProperty ;
    rdfs:label "阈值单位"@zh .

ex:timeWindow a owl:DatatypeProperty ;
    rdfs:label "时间窗口"@zh .

ex:precondition a owl:DatatypeProperty ;
    rdfs:label "前置条件"@zh .

##########
# 概念实例
##########

ex:审批权限 a ex:Topic ;
    rdfs:label "审批权限"@zh .

ex:总经理 a ex:SubjectRole ;
    rdfs:label "总经理"@zh .

ex:总经理办公会 a ex:SubjectRole ;
    rdfs:label "总经理办公会"@zh .

ex:董事会 a ex:SubjectRole ;
    rdfs:label "董事会"@zh .

ex:审批 a ex:Action ;
    rdfs:label "审批"@zh .

ex:审议批准 a ex:Action ;
    rdfs:label "审议批准"@zh .

ex:单项投资 a ex:ObjectEntity ;
    rdfs:label "单项投资"@zh .

ex:一年内累计对外投资 a ex:ObjectEntity ;
    rdfs:label "一年内累计对外投资"@zh .

ex:上述投资 a ex:ObjectEntity ;
    rdfs:label "上述投资"@zh .

ex:可以 a ex:Modality ;
    rdfs:label "可以"@zh .

ex:审批阶段 a ex:Stage ;
    rdfs:label "审批阶段"@zh .

##########
# Article / Item 实例
##########

ex:article_10 a ex:Article ;
    rdfs:label "第十条"@zh ;
    ex:labelText "第十条" ;
    ex:titleText "总经理审批的对外投资" ;
    ex:rawText "第十条 【总经理审批的对外投资】公司总经理或总经理办公会有权决定的对外投资：（一）金额在3,000万元（含3,000万元）以下的单项投资；（二）公司在一年内累计不超过公司最近一期经审计净资产百分之二（含百分之二）的对外投资。上述对外投资权限是经董事会授权的对外投资，董事会如认为必要，可以决定上述投资由董事会审议批准。" ;
    ex:pageStart 4 ;
    ex:pageEnd 5 ;
    ex:hasChild ex:article_10_item_1, ex:article_10_item_2 ;
    ex:hasNormUnit ex:rule_10_1, ex:rule_10_2, ex:rule_10_3 .

ex:article_10_item_1 a ex:Item ;
    rdfs:label "第十条（一）"@zh ;
    ex:labelText "（一）" ;
    ex:rawText "金额在3,000万元（含3,000万元）以下的单项投资。" ;
    ex:pageStart 4 ;
    ex:pageEnd 4 .

ex:article_10_item_2 a ex:Item ;
    rdfs:label "第十条（二）"@zh ;
    ex:labelText "（二）" ;
    ex:rawText "公司在一年内累计不超过公司最近一期经审计净资产百分之二（含百分之二）的对外投资。" ;
    ex:pageStart 4 ;
    ex:pageEnd 4 .

##########
# Threshold 实例
##########

ex:threshold_10_1 a ex:Threshold ;
    rdfs:label "金额小于等于3000万元"@zh ;
    ex:metric "金额" ;
    ex:operator "<=" ;
    ex:value "3000"^^xsd:decimal ;
    ex:unit "万元" .

ex:threshold_10_2 a ex:Threshold ;
    rdfs:label "一年内累计小于等于净资产2%"@zh ;
    ex:metric "最近一期经审计净资产占比" ;
    ex:operator "<=" ;
    ex:value "2"^^xsd:decimal ;
    ex:unit "%" ;
    ex:timeWindow "一年内累计" .

##########
# NormUnit 实例
##########

ex:rule_10_1 a ex:NormUnit ;
    rdfs:label "规则1：总经理审批单项投资"@zh ;
    ex:derivedFrom ex:article_10_item_1 ;
    ex:hasTopic ex:审批权限 ;
    ex:hasSubject ex:总经理, ex:总经理办公会 ;
    ex:hasAction ex:审批 ;
    ex:hasObject ex:单项投资 ;
    ex:hasModality ex:可以 ;
    ex:hasStage ex:审批阶段 ;
    ex:hasThreshold ex:threshold_10_1 .

ex:rule_10_2 a ex:NormUnit ;
    rdfs:label "规则2：总经理审批一年内累计对外投资"@zh ;
    ex:derivedFrom ex:article_10_item_2 ;
    ex:hasTopic ex:审批权限 ;
    ex:hasSubject ex:总经理, ex:总经理办公会 ;
    ex:hasAction ex:审批 ;
    ex:hasObject ex:一年内累计对外投资 ;
    ex:hasModality ex:可以 ;
    ex:hasStage ex:审批阶段 ;
    ex:hasThreshold ex:threshold_10_2 .

ex:rule_10_3 a ex:NormUnit ;
    rdfs:label "规则3：董事会在必要时可审议批准上述投资"@zh ;
    ex:derivedFrom ex:article_10 ;
    ex:hasTopic ex:审批权限 ;
    ex:hasSubject ex:董事会 ;
    ex:hasAction ex:审议批准 ;
    ex:hasObject ex:上述投资 ;
    ex:hasModality ex:可以 ;
    ex:hasStage ex:审批阶段 ;
    ex:precondition "董事会认为必要" .
