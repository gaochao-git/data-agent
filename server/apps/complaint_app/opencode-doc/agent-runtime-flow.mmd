flowchart TD
  %% OpenCode runtime flow: user question -> agents/tools/skills -> response

  A["用户输入<br/>CLI/TUI/Web"] --> B["SessionPrompt.prompt<br/>创建用户消息 + parts"]

  subgraph S1["会话基础初始化"]
    B1["读取/创建 Session"]
    B2["解析 MessageV2 parts<br/>text/file/@agent/command/subtask"]
    B3["兼容旧 tools 配置 -> session 权限"]
  end

  B --> B1 --> B2 --> B3

  subgraph S2["代理初始化-惰性"]
    C0["Agent.get/list/defaultAgent"]
    C1["Agent.state"]
    C2["Config.get 多层合并<br/>well-known -> global -> project -> .opencode/agents -> flags"]
    C3["构建内置代理<br/>build/plan/general/explore/compaction/title/summary"]
    C4["合并用户自定义 agents<br/>opencode.json / .opencode/agents/*.md"]
    C5["兜底权限规则<br/>Truncate.DIR/GLOB"]
  end

  B3 --> C0 --> C1 --> C2 --> C3 --> C4 --> C5

  subgraph S3["系统提示词拼装"]
    D1["SystemPrompt.header/provider"]
    D2["Agent.prompt"]
    D3["项目规则<br/>AGENTS.md/CLAUDE.md/instructions"]
    D4["会话 system 字段"]
  end

  C5 --> D1 --> D2 --> D3 --> D4

  subgraph S4["工具注册"]
    E1["ToolRegistry.tools"]
    E2["内置工具<br/>bash/read/edit/write/task/webfetch/websearch/..."]
    E3["自定义工具<br/>.opencode/tools + plugins"]
    E4["按模型/配置启用或禁用"]
  end

  D4 --> E1 --> E2 --> E3 --> E4

  subgraph S5["权限体系"]
    F1["Permission ruleset<br/>per-agent"]
    F2["PermissionNext.ask<br/>allow/deny/ask"]
  end

  E4 --> F1 --> F2

  subgraph S6["核心循环 SessionPrompt.loop"]
    G1["检查 subtask/compaction"]
    G2["LLM.stream 生成"]
    G3["工具调用/执行"]
    G4["再次生成或结束"]
  end

  F2 --> G1 --> G2 --> G3 --> G4

  %% Subagent path
  subgraph S7["子代理 Subagent 执行"]
    H1["@agent -> AgentPart"]
    H2["LLM 触发 task 工具"]
    H3["TaskTool 创建子会话<br/>parentID=主会话"]
    H4["子会话运行 SessionPrompt.prompt"]
    H5["结果作为 tool output 回填主会话"]
  end

  G3 --> H1 --> H2 --> H3 --> H4 --> H5 --> G4

  %% Skill path
  subgraph S8["Skill 执行"]
    I1["LLM 调用 skill 工具"]
    I2["读取 SKILL.md"]
    I3["按技能流程调用工具<br/>可能 bash/read/edit..."]
  end

  G3 --> I1 --> I2 --> I3 --> G4

  %% Output
  subgraph S9["输出"]
    J1["Tool 结果写回 MessageV2.ToolPart"]
    J2["生成最终 assistant 回复"]
  end

  G4 --> J1 --> J2

  %% Compaction/summary/title side effects
  subgraph S10["系统辅助代理"]
    K1["compaction"]
    K2["title"]
    K3["summary"]
  end

  G1 --> K1
  G4 --> K2
  G4 --> K3
