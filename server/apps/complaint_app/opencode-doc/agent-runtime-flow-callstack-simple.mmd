sequenceDiagram
  autonumber
  participant U as User
  participant UI as CLI/TUI/Web<br/>(client)
  participant SP as SessionPrompt<br/>(session/prompt.ts)
  participant A as Agent Registry<br/>(agent/agent.ts)
  participant Cfg as Config<br/>(config/config.ts)
  participant Sys as SystemPrompt<br/>(session/system.ts)
  participant LLM as LLM.stream<br/>(session/llm.ts)
  participant TR as ToolRegistry<br/>(tool/registry.ts)
  participant Perm as PermissionNext<br/>(permission/next.ts)
  participant Tool as Tools<br/>(tool/*)
  participant Task as TaskTool<br/>(tool/task.ts)
  participant Skill as SkillTool<br/>(tool/skill.ts)

  U->>UI: 输入问题
  UI->>SP: prompt(input)

  SP->>A: get/list/defaultAgent
  A->>Cfg: get() 合并配置
  Cfg-->>A: agent 配置
  A-->>SP: Agent.Info

  SP->>Sys: 组装 system 提示
  Sys-->>SP: provider + agent + rules

  SP->>TR: tools(model, agent)
  TR-->>SP: 可用工具集

  loop SessionPrompt.loop
    SP->>LLM: 生成响应
    LLM-->>SP: tool calls / text

    opt 工具调用
      SP->>Perm: ask(permission)
      Perm-->>SP: allow/deny/ask
      SP->>Tool: execute
      Tool-->>SP: tool output
    end

    opt 子代理(@agent/subtask)
      SP->>Task: execute
      Task-->>SP: tool output(子会话结果)
    end

    opt Skill 工具
      SP->>Skill: execute
      Skill-->>SP: tool output
    end
  end

  SP-->>UI: 回复
  UI-->>U: 输出结果
