flowchart TD
  A["主会话 SessionPrompt.loop<br/>(session/prompt.ts)"]
  B["检测 pending subtask?<br/>(session/prompt.ts)"]
  C["TaskTool.execute<br/>(tool/task.ts)"]
  D["创建子会话 parentID=主会话<br/>(session/index.ts)"]
  E["子会话 SessionPrompt.prompt<br/>(session/prompt.ts)"]
  F["子会话输出 -> tool result<br/>(tool/task.ts)"]
  G["回填主会话<br/>(session/processor.ts)"]

  A --> B
  B -- yes --> C --> D --> E --> F --> G
  B -- no --> H["常规 LLM 生成<br/>(session/processor.ts + session/llm.ts)"]

  H --> I["检查是否溢出<br/>(session/compaction.ts:isOverflow)"]
  I -- yes --> J["SessionCompaction.create<br/>(session/compaction.ts)"]
  J --> K["Compaction part queued<br/>(session/message-v2.ts)"]
  K --> L["SessionCompaction.process<br/>(session/compaction.ts)"]
  L --> M["compaction agent 生成 summary<br/>(agent/agent.ts + session/processor.ts)"]
  M --> N["写入 summary message<br/>(session/index.ts)"]
  I -- no --> O["继续下一步<br/>(session/prompt.ts)"]

  %% pruning
  P["SessionCompaction.prune<br/>(session/compaction.ts)"]
  O --> P
