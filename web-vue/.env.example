# API 请求前缀（开发环境用 /dev-api，生产环境用 /prod-api）
VITE_APP_BASE_API=/dev-api

# Agents 后端地址
VITE_API_BASE_URL_AGENTS=http://127.0.0.1:5001

# 业务后端地址
VITE_API_BASE_URL=http://127.0.0.1:8080

# 本地开发直连 Agents 后端时，由 Vite proxy 注入服务转发头；需与后端 SERVICE_AUTH_TOKEN 一致
# AGENT_USERNAME 与网关口径一致，直接配置 UTF-8 Base64 后的用户名
# AGENT_SERVICE_TOKEN=replace-this-in-local-dev
# AGENT_USER_ID=10001
# AGENT_USERNAME=5pys5Zyw5byA5Y+R55So5oi3
